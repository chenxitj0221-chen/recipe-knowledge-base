  "components": [
    {
      "id": "saffron-sauce",
      "name": { "original": "Saffron Sauce", "original_lang": "en", "translation": "藏红花酱", "translation_lang": "zh" },
      "prep_ahead": "same day",
      "reusable": true,
      "ingredients": [
        { "item": { "original": "onion", "original_lang": "en", "translation": "洋葱", "translation_lang": "zh" }, "amount": "50 g" },
        { "item": { "original": "butter", "original_lang": "en", "translation": "黄油", "translation_lang": "zh" }, "amount": "75 g" },
        { "item": { "original": "white wine", "original_lang": "en", "translation": "白葡萄酒", "translation_lang": "zh" }, "amount": "100 g" },
        { "item": { "original": "bomba paella rice", "original_lang": "en", "translation": "Bomba 海鲜饭米", "translation_lang": "zh" }, "amount": "75 g" },
        { "item": { "original": "saffron", "original_lang": "en", "translation": "藏红花", "translation_lang": "zh" }, "amount": "0.5 g" },
        { "item": { "original": "stock", "original_lang": "en", "translation": "高汤", "translation_lang": "zh" }, "amount": "350 g" },
        { "item": { "original": "salt and white pepper", "original_lang": "en", "translation": "盐和白胡椒", "translation_lang": "zh" }, "amount": "to taste" }
      ],
      "method_steps": [
        { "original": "Put the finely chopped onion with the wine in a small saucepan, heat until the wine is completely reduced.", "original_lang": "en", "translation": "洋葱切碎，与白葡萄酒入小锅，加热至酒完全收干。", "translation_lang": "zh" },
        { "original": "Add the butter and when it melts add the saffron, cook for a few seconds over high heat.", "original_lang": "en", "translation": "加黄油，融化后加藏红花，大火炒几秒。", "translation_lang": "zh" },
        { "original": "Add the bomba rice. Continue cooking for a few more minutes and add the stock.", "original_lang": "en", "translation": "加 Bomba 米，继续炒几分钟，加高汤。", "translation_lang": "zh" },
        { "original": "Cook for 18 minutes, or until it starts to cook through.", "original_lang": "en", "translation": "煮 18 分钟，或至米开始熟透。", "translation_lang": "zh" },
        { "original": "Season with salt and pepper. Blend. Leave to cool and reserve.", "original_lang": "en", "translation": "盐和胡椒调味。搅打均匀。冷却备用。", "translation_lang": "zh" }
      ]
    },
    {
      "id": "sauteed-vegetables",
      "name": { "original": "Sauteed Vegetables", "original_lang": "en", "translation": "炒蔬菜", "translation_lang": "zh" },
      "prep_ahead": "same day, marinate min 2 hours",
      "reusable": true,
      "ingredients": [
        { "item": { "original": "courgette", "original_lang": "en", "translation": "西葫芦", "translation_lang": "zh" }, "amount": "50 g" },
        { "item": { "original": "carrot", "original_lang": "en", "translation": "胡萝卜", "translation_lang": "zh" }, "amount": "50 g" },
        { "item": { "original": "white cabbage", "original_lang": "en", "translation": "白卷心菜", "translation_lang": "zh" }, "amount": "50 g" },
        { "item": { "original": "celery", "original_lang": "en", "translation": "芹菜", "translation_lang": "zh" }, "amount": "50 g" },
        { "item": { "original": "spring onion", "original_lang": "en", "translation": "小葱", "translation_lang": "zh" }, "amount": "50 g" },
        { "item": { "original": "ginger", "original_lang": "en", "translation": "姜", "translation_lang": "zh" }, "amount": "10 g" },
        { "item": { "original": "salt and pepper", "original_lang": "en", "translation": "盐和胡椒", "translation_lang": "zh" }, "amount": "to taste" },
        { "item": { "original": "olive oil", "original_lang": "en", "translation": "橄榄油", "translation_lang": "zh" }, "amount": "as needed" }
      ],
      "method_steps": [
        { "original": "Slice the vegetables very thinly. Add the grated ginger, salt, pepper and oil.", "original_lang": "en", "translation": "蔬菜切薄片，加姜末、盐、胡椒、油。", "translation_lang": "zh" },
        { "original": "Leave the mixture to marinate for a minimum of 2 hours.", "original_lang": "en", "translation": "腌制至少 2 小时。", "translation_lang": "zh" },
        { "original": "Saute in a very hot pan with oil for 2 minutes.", "original_lang": "en", "translation": "大火热锅，油炒 2 分钟。", "translation_lang": "zh" },
        { "original": "Reserve. Serve al dente.", "original_lang": "en", "translation": "备用，保持脆度上桌。", "translation_lang": "zh" }
      ]
    }
  ],

