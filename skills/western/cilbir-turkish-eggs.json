  "assembly": {
    "name": {
      "original": "Plating: Cilbir - Turkish Eggs on Flatbread",
      "original_lang": "en",
      "translation": "装盘：土耳其蛋配扁面包",
      "translation_lang": "zh"
    },
    "steps": [
      {
        "original": "Cook your flatbreads and allow to drain of oil for a minute.",
        "original_lang": "en",
        "translation": "烤好扁面包，沥油一分钟。",
        "translation_lang": "zh"
      },
      {
        "original": "Place your cooked flatbread on to a tray or rack for garnishing. We will not garnish and finish plating directly on the serving plate as it will keep the final plate clean and beautifully presented.",
        "original_lang": "en",
        "translation": "扁面包放在烤架或托盘上装饰。不要直接在出餐盘上装饰，以保持成品干净美观。",
        "translation_lang": "zh"
      },
      {
        "original": "Brush the oil, sumac and mint oil all around the edges of the flatbread.",
        "original_lang": "en",
        "translation": "用刷油（橄榄油、苏马克、薄荷油）刷扁面包边缘。",
        "translation_lang": "zh"
      },
      {
        "original": "Pipe garlic labneh into the middle of the flatbread and spread out with the back of a spoon - almost to the edges, about 1.5cm from the edge.",
        "original_lang": "en",
        "translation": "将蒜味 Labneh 挤在扁面包中央，用勺背抹开至距边缘约 1.5 cm。",
        "translation_lang": "zh"
      },
      {
        "original": "Flash your eggs in the boiling water for a few seconds to heat, then place them into the center of the labneh.",
        "original_lang": "en",
        "translation": "水波蛋在沸水中快速复热几秒，放在 Labneh 中央。",
        "translation_lang": "zh"
      },
      {
        "original": "Spoon the brown butter over the eggs and labneh, making sure to leak over the sides slightly for colour contrast.",
        "original_lang": "en",
        "translation": "将棕色黄油淋在蛋和 Labneh 上，让黄油略微流到边缘形成颜色对比。",
        "translation_lang": "zh"
      },
      {
        "original": "Dress the herb salad generously with lemon dressing and season to taste.",
        "original_lang": "en",
        "translation": "香草沙拉用柠檬油醋汁充分拌匀，调味。",
        "translation_lang": "zh"
      },
      {
        "original": "Decorate the eggs and labneh with the salad.",
        "original_lang": "en",
        "translation": "用沙拉装饰蛋和 Labneh。",
        "translation_lang": "zh"
      },
      {
        "original": "Finish garnishing the salad with the pickled red onions.",
        "original_lang": "en",
        "translation": "最后撒上腌红洋葱。",
        "translation_lang": "zh"
      },
      {
        "original": "Sprinkle over some sumac to finish.",
        "original_lang": "en",
        "translation": "再撒一些苏马克收尾。",
        "translation_lang": "zh"
      },
      {
        "original": "Move your beautiful flatbread on to a plate and serve!",
        "original_lang": "en",
        "translation": "将扁面包移至餐盘上桌。",
        "translation_lang": "zh"
      }
    ]
  },

