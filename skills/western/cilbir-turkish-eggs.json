          "amount": "2 per portion"
        },
        {
          "item": {
            "original": "white wine vinegar",
            "original_lang": "en",
            "translation": "白葡萄酒醋",
            "translation_lang": "zh"
          },
          "amount": "1 cup",
          "note": {
            "original": "for poaching water",
            "original_lang": "en",
            "translation": "煮蛋水中",
            "translation_lang": "zh"
          }
        },
        {
          "item": {
            "original": "salt",
            "original_lang": "en",
            "translation": "盐",
            "translation_lang": "zh"
          },
          "amount": "a handful",
          "note": {
            "original": "for poaching water",
            "original_lang": "en",
            "translation": "煮蛋水中",
            "translation_lang": "zh"
          }
        }
      ],
      "method_steps": [
        {
          "original": "Fill a large pot with water and bring it up to a light rolling boil.",
          "original_lang": "en",
          "translation": "大锅水烧至微滚。",
          "translation_lang": "zh"
        },
        {
          "original": "Add a handful of salt and one cup of white wine vinegar and mix.",
          "original_lang": "en",
          "translation": "加一把盐和一杯白葡萄酒醋，搅匀。",
          "translation_lang": "zh"
        },
        {
          "original": "With the rolling boil add in the eggs one by one, as quickly as possible so they all cook evenly.",
          "original_lang": "en",
          "translation": "鸡蛋逐个快速下锅，使受热均匀。",
          "translation_lang": "zh"
        },
        {
          "original": "Very lightly turn the water with the spoon to keep the eggs floating and moving around in the pot.",
          "original_lang": "en",
          "translation": "用勺轻推水面，让蛋保持浮动。",
          "translation_lang": "zh"
        },
        {
          "original": "When cooked to your liking, remove the eggs with a slotted spoon.",
          "original_lang": "en",
          "translation": "达到理想熟度后用漏勺捞出。",
          "translation_lang": "zh"
        },
        {
          "original": "Place the eggs into a tupperware container with water inside to keep the round shape - ready to reheat just before plating.",
          "original_lang": "en",
          "translation": "放入装有水的保鲜盒中保持圆形，上桌前快速复热。",
          "translation_lang": "zh"
        }
      ]
    },
