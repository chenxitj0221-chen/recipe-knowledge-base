            "translation": "白葡萄酒醋",
            "translation_lang": "zh"
          },
          "amount": "200 g"
        },
        {
          "item": {
            "original": "water",
            "original_lang": "en",
            "translation": "水",
            "translation_lang": "zh"
          },
          "amount": "200 g"
        },
        {
          "item": {
            "original": "caster sugar",
            "original_lang": "en",
            "translation": "细砂糖",
            "translation_lang": "zh"
          },
          "amount": "100 g"
        },
        {
          "item": {
            "original": "fennel seeds",
            "original_lang": "en",
            "translation": "茴香籽",
            "translation_lang": "zh"
          },
          "amount": "10"
        },
        {
          "item": {
            "original": "cloves",
            "original_lang": "en",
            "translation": "丁香",
            "translation_lang": "zh"
          },
          "amount": "2"
        },
        {
          "item": {
            "original": "coriander seeds",
            "original_lang": "en",
            "translation": "芫荽籽",
            "translation_lang": "zh"
          },
          "amount": "5"
        },
        {
          "item": {
            "original": "yellow mustard seeds",
            "original_lang": "en",
            "translation": "黄芥末籽",
            "translation_lang": "zh"
          },
          "amount": "1 tbsp"
        }
      ],
      "method_steps": [
        {
          "original": "Slice the onions thinly and place them in a tupperware container suitable for very hot liquid.",
          "original_lang": "en",
          "translation": "洋葱切细丝，放入耐热容器。",
          "translation_lang": "zh"
        },
        {
          "original": "Add the vinegar, water and sugar to a pot and bring to the boil.",
          "original_lang": "en",
          "translation": "醋、水、糖入锅煮沸。",
          "translation_lang": "zh"
        },
        {
          "original": "Stir so the sugar dissolves.",
          "original_lang": "en",
          "translation": "搅拌至糖溶解。",
          "translation_lang": "zh"
        },
        {
          "original": "Add in the aromats and remove from the heat.",
          "original_lang": "en",
          "translation": "加入香料，离火。",
          "translation_lang": "zh"
        },
        {
          "original": "Pour the liquid over the red onions, submerge them with the back of a spoon.",
          "original_lang": "en",
          "translation": "将热液倒入洋葱，用勺背压住使其浸没。",
          "translation_lang": "zh"
        },
        {
          "original": "Place a piece of parchment paper over the top and press it against the liquid.",
          "original_lang": "en",
          "translation": "表面盖烘焙纸，压住液体。",
          "translation_lang": "zh"
        },
        {
          "original": "Cool to room temperature, then refrigerate with a lid. Ready after 4 hours, best after 12.",
          "original_lang": "en",
          "translation": "室温冷却后加盖冷藏。4 小时后可用，12 小时最佳。",
          "translation_lang": "zh"
        }
      ]
    },
