    {
      "id": "poached-eggs",
      "name": {
        "original": "Poached Eggs",
        "original_lang": "en",
        "translation": "水波蛋",
        "translation_lang": "zh"
      },
      "prep_ahead": "same day (can be pre-poached and reheated)",
      "reusable": false,
      "ingredients": [
        {
          "item": {
            "original": "eggs",
            "original_lang": "en",
            "translation": "鸡蛋",
