{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake.schema.json",
  "title": "Recipe Intake Format",
  "description": "外部编辑系统提交的菜谱格式。只装原文（Source Knowledge），单一语言；翻译、分类、过敏原等由知识库生成。说明见 docs/intake-format.md。",
  "type": "object",
  "required": ["format_version", "provenance", "lang", "name", "servings", "components", "assembly"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "const": "0.1" },
    "provenance": {
      "type": "object",
      "required": ["source_type", "source_title", "author", "source_path", "locator", "edited_by", "edited_at"],
      "additionalProperties": false,
      "properties": {
        "source_type": { "enum": ["book", "magazine", "chef", "video", "web", "other"] },
        "source_title": { "type": "string", "minLength": 1 },
        "author": { "type": ["string", "null"] },
        "source_path": { "type": ["string", "null"], "description": "原始资料在本地电脑的位置；未知填 null" },
        "locator": { "type": ["string", "null"], "description": "页码或视频时间点，如 \"p.42\"、\"12:30\"" },
        "edited_by": { "type": "string", "minLength": 1 },
        "edited_at": { "type": "string", "format": "date" }
      }
    },
    "lang": { "type": "string", "pattern": "^[a-z]{2}$" },
    "name": { "type": "string", "minLength": 1 },
    "servings": {
      "type": "object",
      "required": ["qty", "raw"],
      "additionalProperties": false,
      "properties": {
        "qty": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "raw": { "type": ["string", "null"], "description": "原文对份量的写法；原文未写填 null" }
      }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "assembly": {
      "type": "object",
      "required": ["ingredients", "steps"],
      "additionalProperties": false,
      "properties": {
        "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" } },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" }, "description": "原文中的提示、注意事项" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "component": {
      "type": "object",
      "required": ["id", "name", "ingredients", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "description": "自由命名，沿用原文叫法" },
        "type": { "$ref": "#/$defs/id", "description": "可选；取自 mappings/component-types.json" },
        "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" } },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "ingredient": {
      "type": "object",
      "required": ["id", "raw", "item", "qty", "unit"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "raw": { "type": "string", "minLength": 1, "description": "原文整行，一字不改；原文未列出的食材写步骤里的原话" },
        "item": { "type": "string", "minLength": 1 },
        "qty": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "unit": { "type": ["string", "null"] },
        "prep": { "type": ["string", "null"], "description": "原文写明的处理方式，如「切薄片」" },
        "listed_in_source": { "type": "boolean", "default": true, "description": "原文食材表未列出、只在步骤中出现时填 false" }
      }
    },
    "step": {
      "type": "object",
      "required": ["text", "uses"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1, "description": "原文步骤，一字不改" },
        "uses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref"],
            "additionalProperties": false,
            "properties": {
              "ref": { "$ref": "#/$defs/id", "description": "食材 id，或前面组件的 id" },
              "qty": { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "仅当原文写明本步用量时填" },
              "unit": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
